{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Yeman Zefen design tokens, direction F 'Adey' (sunny yellow, cream cards, cassette motif). Light theme only: no dark theme was designed in Sprint 1. Values are taken from the hi-fi HTML in docs/design/artifacts/. Sizes are logical pixels (Flutter dp) on a 360-wide phone. Gradients list stops top to bottom unless 'angle' says otherwise. Shadows use CSS box-shadow order: x, y, blur, color; a blur of 0 is a solid 'press edge' under the element.",

  "color": {
    "$type": "color",
    "palette": {
      "sun50":   { "$value": "#FFF3D1", "$description": "Cream: fade under the hero, sheet top, light text on dark" },
      "sun200":  { "$value": "#FFE07A" },
      "sun300":  { "$value": "#FFDF6E" },
      "sun400":  { "$value": "#FFC93C", "$description": "Brand yellow" },
      "sun500":  { "$value": "#FFB02E" },
      "sun550":  { "$value": "#FFAE2E" },
      "sun600":  { "$value": "#FFA94D", "$description": "Orange end of full-screen yellow backgrounds" },
      "sun800":  { "$value": "#D99418", "$description": "Press edge of yellow buttons" },
      "coral":   { "$value": "#F0563A", "$description": "Always with ink text, never white (white on coral is ~3.4:1)" },
      "sage":    { "$value": "#7FB5A8" },
      "sand":    { "$value": "#E3C9A0" },
      "lavender":{ "$value": "#C9B8EC" },
      "ink":     { "$value": "#2B2118", "$description": "Primary text and dark surfaces" },
      "ink700":  { "$value": "#4A3B2E", "$description": "Secondary text" },
      "ink650":  { "$value": "#3A2D22", "$description": "Text on the yellow hero" },
      "inkDeep": { "$value": "#120D09", "$description": "Press edge of dark surfaces" },
      "slate":   { "$value": "#2E3D39", "$description": "Top stop of dark card gradients" },
      "cream100":{ "$value": "#FBF4E8", "$description": "Bottom stop of cards, segmented-control track" },
      "cream200":{ "$value": "#F1E8DA", "$description": "Dividers, progress track" },
      "cream300":{ "$value": "#EDE3D2", "$description": "Press edge of cards" },
      "white":   { "$value": "#FFFFFF" },
      "teal500": { "$value": "#2A8A77" },
      "teal700": { "$value": "#1D6658" },
      "teal900": { "$value": "#144A40" },
      "red500":  { "$value": "#DC4A30" },
      "red700":  { "$value": "#B8321B" },
      "red900":  { "$value": "#8A2614" }
    },

    "background": {
      "screen":       { "$value": "{color.palette.white}", "$description": "Body area below the hero" },
      "heroFade":     { "$value": "{color.palette.sun50}", "$description": "Body area starts cream and fades to white over 140 px, under the hero's curve" },
      "screenFoot":   { "$value": "#F3FAF8", "$description": "Faint mint at the bottom of the round screen" },
      "scrim":        { "$value": "rgba(43,33,24,0.45)", "$description": "Behind bottom sheets" },
      "adOverlay":    { "$value": "{color.palette.ink}", "$description": "Full-screen ad placeholder, gradient to #1C1510" }
    },
    "surface": {
      "card":         { "$value": "{color.palette.white}", "$description": "Gradient white → cream100" },
      "cardEnd":      { "$value": "{color.palette.cream100}" },
      "cardEdge":     { "$value": "{color.palette.cream300}" },
      "cardOnYellow": { "$value": "rgba(255,255,255,0.7)", "$description": "Stat tiles on the Home hero" },
      "dark":         { "$value": "{color.palette.ink}", "$description": "Selected options, Leaderboard row, offline banner. Gradient slate → ink" },
      "darkEdge":     { "$value": "{color.palette.inkDeep}" },
      "segmentTrack": { "$value": "{color.palette.cream100}" },
      "divider":      { "$value": "{color.palette.cream200}" },
      "errorCard":    { "$value": "#FFF1EC", "$description": "Inline error card, gradient #FFF1EC → #FFE3DA, edge #F4C7B8" },
      "errorCardEnd": { "$value": "#FFE3DA" },
      "errorCardEdge":{ "$value": "#F4C7B8" }
    },
    "primary": {
      "fill":         { "$value": "{color.palette.sun400}", "$description": "Buttons: gradient sun200 0% → sun400 50% → sun550 100%" },
      "fillTop":      { "$value": "{color.palette.sun200}" },
      "fillBottom":   { "$value": "{color.palette.sun550}" },
      "edge":         { "$value": "{color.palette.sun800}" },
      "onFill":       { "$value": "{color.palette.ink}" },
      "accentOnDark": { "$value": "{color.palette.sun400}", "$description": "Icons and selected text on dark surfaces" }
    },
    "hero": {
      "top":    { "$value": "{color.palette.sun300}", "$description": "Hero gradient: sun300 0% → sun400 55% → sun500 100%, plus a white radial glow (45% → 0) behind the focal element" },
      "middle": { "$value": "{color.palette.sun400}" },
      "bottom": { "$value": "{color.palette.sun500}" },
      "fullScreenBottom": { "$value": "{color.palette.sun600}", "$description": "Leaderboard and loading screens, which are yellow top to bottom" },
      "glow":   { "$value": "rgba(255,255,255,0.45)" }
    },
    "text": {
      "primary":   { "$value": "{color.palette.ink}" },
      "secondary": { "$value": "{color.palette.ink700}" },
      "onHero":    { "$value": "{color.palette.ink650}" },
      "onDark":    { "$value": "{color.palette.sun50}" },
      "onDarkMuted": { "$value": "{color.palette.sand}" },
      "onAnswerState": { "$value": "{color.palette.white}", "$description": "Text on correct and wrong answer tiles" },
      "error":     { "$value": "{color.palette.red900}" }
    },
    "correct": {
      "fill":     { "$value": "{color.palette.teal700}", "$description": "Gradient teal500 → teal700. Always paired with a check icon and the word 'Correct'" },
      "fillTop":  { "$value": "{color.palette.teal500}" },
      "edge":     { "$value": "{color.palette.teal900}" },
      "glow":     { "$value": "rgba(35,120,106,0.35)" },
      "text":     { "$value": "{color.palette.teal700}", "$description": "'Correct +143' heading on white" }
    },
    "wrong": {
      "fill":     { "$value": "{color.palette.red700}", "$description": "Gradient red500 → red700. Always paired with an X icon and 'Your pick'" },
      "fillTop":  { "$value": "{color.palette.red500}" },
      "edge":     { "$value": "{color.palette.red900}" },
      "glow":     { "$value": "rgba(210,60,34,0.35)" },
      "text":     { "$value": "{color.palette.red700}", "$description": "'Not this one' / 'Time's up' heading on white" }
    },
    "answer": {
      "dimOpacity":     { "$type": "number", "$value": 0.45, "$description": "Unpicked, incorrect tiles during feedback" },
      "removedOpacity": { "$type": "number", "$value": 0.18, "$description": "Tiles removed by the hint; not tappable, no shadow" }
    },
    "timer": {
      "track":      { "$value": "rgba(255,255,255,0.55)" },
      "fill":       { "$value": "{color.palette.teal500}", "$description": "Gradient left to right teal500 → sage" },
      "fillEnd":    { "$value": "{color.palette.sage}" },
      "pill":       { "$value": "{color.palette.white}", "$description": "Seconds-left pill; reads 'Paused' while the hint sheet or rewarded ad is up" }
    },
    "toggle": {
      "on":    { "$value": "{color.palette.teal700}", "$description": "Gradient teal500 → teal700, white knob" },
      "knob":  { "$value": "{color.palette.white}" }
    },
    "era": {
      "$description": "Era accents: era chips, era cards and pack art. Ink text on all of them.",
      "all":    { "$value": "{color.palette.white}", "$description": "All eras: white → cream100 card" },
      "golden": { "$value": "{color.palette.sun400}", "$description": "Golden Age, before 1980" },
      "80s":    { "$value": "{color.palette.coral}" },
      "90s":    { "$value": "{color.palette.sage}" },
      "2000s":  { "$value": "{color.palette.sand}" },
      "modern": { "$value": "{color.palette.lavender}", "$description": "2010 and later" },
      "selectedRing": { "$value": "{color.palette.ink}", "$description": "3 px outline, 2 px offset" }
    },
    "cassette": {
      "$description": "The round screen's cassette (the 'playing indicator').",
      "body":      { "$value": "#4A3B2E", "$description": "Gradient #4A3B2E → ink" },
      "label":     { "$value": "#FF8A5C", "$description": "Gradient #FF8A5C → #E0452A" },
      "labelEnd":  { "$value": "#E0452A" },
      "stripe":    { "$value": "{color.palette.sun400}", "$description": "Gradient sun400 → sun200" },
      "window":    { "$value": "{color.palette.ink}" },
      "tape":      { "$value": "#5A4636", "$description": "Gradient #5A4636 → #3B2F25, also the bottom tab" },
      "reelHub":   { "$value": "{color.palette.sun400}" },
      "reel":      { "$value": "{color.palette.sun50}" },
      "glow":      { "$value": "rgba(240,86,58,0.45)" }
    },
    "logoTiles": {
      "$description": "Wordmark የማን ዘፈን, one Fidel per tile, in this order",
      "sequence": { "$type": "string", "$value": "white, sage, white | coral, white, sand" }
    }
  },

  "typography": {
    "family": {
      "latin":    { "$type": "fontFamily", "$value": ["Poppins", "sans-serif"] },
      "ethiopic": { "$type": "fontFamily", "$value": ["Noto Sans Ethiopic", "sans-serif"] },
      "$description": "In English, Poppins first with Noto Sans Ethiopic as fallback; in Amharic, the reverse. Numerals, scores and the round counter are always Poppins."
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    },
    "lineHeight": {
      "$type": "number",
      "latin":         { "$value": 1.4 },
      "ethiopic":      { "$value": 1.55, "$description": "Fidel needs the extra room for its marks" },
      "ethiopicDense": { "$value": 1.5,  "$description": "Era setup, Offline play, Settings: screens with many rows" },
      "heading":       { "$value": 1.35, "$description": "Headings in both scripts" }
    },
    "scale": {
      "$description": "fontSize in px/dp. Same sizes in both scripts.",
      "caption":   { "$value": { "fontSize": 12, "fontWeight": 600 }, "$description": "Meta lines, stat labels, answer marks" },
      "label":     { "$value": { "fontSize": 13, "fontWeight": 700 }, "$description": "Chips, section headers, small buttons" },
      "bodySmall": { "$value": { "fontSize": 14, "fontWeight": 700 }, "$description": "List row titles" },
      "body":      { "$value": { "fontSize": 15, "fontWeight": 400 } },
      "bodyLarge": { "$value": { "fontSize": 16, "fontWeight": 700 }, "$description": "Answer tiles, intro paragraphs (400)" },
      "button":    { "$value": { "fontSize": 17, "fontWeight": 800 }, "$description": "Primary buttons; the Play button in the bar is 18" },
      "titleSmall":{ "$value": { "fontSize": 20, "fontWeight": 800 }, "$description": "Screen titles, round question" },
      "title":     { "$value": { "fontSize": 24, "fontWeight": 800 }, "$description": "Feedback heading, message screens, Home greeting" },
      "display":   { "$value": { "fontSize": 26, "fontWeight": 800 }, "$description": "Welcome and onboarding" },
      "score":     { "$value": { "fontSize": 52, "fontWeight": 800 }, "$description": "Results total, Poppins" }
    },
    "textScaleMax": { "$type": "number", "$value": 1.3, "$description": "Every screen must fit at 1.3 on a 360-wide screen" }
  },

  "spacing": {
    "$type": "dimension",
    "2": { "$value": "2px" },
    "4": { "$value": "4px" },
    "6": { "$value": "6px" },
    "8": { "$value": "8px" },
    "10": { "$value": "10px" },
    "12": { "$value": "12px", "$description": "Default gap between cards and answer tiles" },
    "14": { "$value": "14px" },
    "16": { "$value": "16px", "$description": "Screen side padding in the body" },
    "18": { "$value": "18px", "$description": "Screen side padding in the hero" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" },
    "28": { "$value": "28px", "$description": "Body top padding under the hero (hero overlaps by 12)" },
    "32": { "$value": "32px" },
    "heroOverlap": { "$value": "-12px", "$description": "Body starts 12 px under the hero so the curve sits over the cream fade" },
    "touchTargetMin": { "$value": "48px", "$description": "Minimum hit area for anything tappable" }
  },

  "radius": {
    "$type": "dimension",
    "progress": { "$value": "4px" },
    "pill": { "$value": "12px", "$description": "Chips, timer pill, logo tiles (9–12)" },
    "small": { "$value": "14px", "$description": "Small buttons, segmented-control items, icon tiles" },
    "card": { "$value": "18px", "$description": "List cards, pack rows, segmented-control track (16–18)" },
    "large": { "$value": "20px", "$description": "Answer tiles, primary buttons, option rows" },
    "playButton": { "$value": "22px" },
    "badge": { "$value": "36px", "$description": "Message-screen icon badge (120 × 120)" },
    "bottomBar": { "$value": "36px 36px 0 0" },
    "sheet": { "$value": "32px 32px 0 0" },
    "hero": { "$value": "0 0 44px 44px", "$description": "Curved bottom of the yellow hero; 40 on denser screens" }
  },

  "elevation": {
    "$type": "shadow",
    "$description": "Every raised element has a solid press edge (blur 0) plus a soft shadow. Pressing moves the element down by the edge height and removes the edge.",
    "card":      { "$value": "0 4px 0 #EDE3D2, 0 8px 18px rgba(43,33,24,0.06)" },
    "row":       { "$value": "0 5px 0 #EDE3D2, 0 10px 22px rgba(43,33,24,0.08)" },
    "answer":    { "$value": "0 6px 0 #EDE3D2, 0 12px 26px rgba(43,33,24,0.10)" },
    "answerCorrect": { "$value": "0 6px 0 #144A40, 0 12px 28px rgba(35,120,106,0.35)" },
    "answerWrong":   { "$value": "0 6px 0 #8A2614, 0 12px 28px rgba(210,60,34,0.35)" },
    "primary":   { "$value": "0 6px 0 #D99418, 0 12px 26px rgba(255,170,46,0.40), inset 0 2px 0 rgba(255,255,255,0.6)" },
    "primarySmall": { "$value": "0 4px 0 #D99418" },
    "dark":      { "$value": "0 5px 0 #120D09, 0 10px 22px rgba(43,33,24,0.20)" },
    "iconButton":{ "$value": "0 4px 0 rgba(0,0,0,0.10)" },
    "chip":      { "$value": "0 3px 0 rgba(0,0,0,0.12), inset 0 10px 12px rgba(255,255,255,0.38)" },
    "hero":      { "$value": "0 14px 30px rgba(255,176,46,0.35)" },
    "bottomBar": { "$value": "0 -10px 26px rgba(255,169,77,0.28)" },
    "glossInset":{ "$value": "inset 0 10px 12px rgba(255,255,255,0.38)", "$description": "On coloured icon tiles, era cards and pack art" }
  },

  "size": {
    "$type": "dimension",
    "iconButton": { "$value": "48px", "$description": "Back button; 52 in the bottom bar" },
    "playButton": { "$value": { "minWidth": "140px", "height": "62px" } },
    "answerTile": { "$value": { "minHeight": "84px" }, "$description": "2 × 2 grid, 12 gap" },
    "primaryButton": { "$value": { "minHeight": "58px" } },
    "secondaryButton": { "$value": { "minHeight": "54px" } },
    "listRow": { "$value": { "minHeight": "64px" } },
    "eraCard": { "$value": { "minHeight": "52px" } },
    "chip": { "$value": { "minHeight": "34px" }, "$description": "Display chips; tappable genre chips are 44 with padding to 48 hit area" },
    "toggle": { "$value": { "width": "46px", "height": "28px" } },
    "timerBar": { "$value": { "height": "8px" } },
    "cassette": { "$value": { "width": "200px", "height": "128px" } },
    "iconStroke": { "$value": "2px", "$description": "Line icons, 24 grid; 2.5 for chevrons, 3 for check/X marks" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "press":     { "$value": "120ms", "$description": "Button and tile press (translate by edge height)" },
      "fade":      { "$value": "200ms", "$description": "Opacity changes: dimming, hint-removed" },
      "answerPop": { "$value": "300ms", "$description": "Correct/wrong reveal: scale 0.96 → 1.03 (60%) → 1" },
      "reelSpin":  { "$value": "1200ms", "$description": "One turn of a cassette reel, repeats while the clip plays" },
      "shimmer":   { "$value": "1400ms", "$description": "Skeleton sweep, repeats" },
      "timerTick": { "$value": "100ms", "$description": "Timer bar update rate" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.25, 0.1, 0.25, 1], "$description": "CSS 'ease': press, fade, pop" },
      "linear":   { "$value": [0, 0, 1, 1], "$description": "Reel spin, shimmer, timer bar" }
    },
    "reducedMotion": {
      "$type": "string",
      "$value": "No reel spin, no pop (state change is instant), static skeletons. Timers and durations below are unchanged."
    }
  },

  "timing": {
    "$description": "Game pacing decided in Sprint 1. The scoring window itself is in docs/scoring.md.",
    "$type": "duration",
    "feedbackCorrect": { "$value": "1000ms", "$description": "Correct reveal, then auto-advance" },
    "feedbackWrong":   { "$value": "5000ms", "$description": "Wrong or time-out reveal; a tap anywhere skips it" },
    "hintSheetMax":    { "$value": "8000ms", "$description": "Hint sheet auto-closes; the round timer is paused while it is open and while the rewarded ad plays" },
    "skeletonDelay":   { "$value": "300ms", "$description": "Show a skeleton only if loading takes longer than this" },
    "nextSongWaitMax": { "$value": "10000ms", "$description": "Round waits for a clip download at most this long, then is skipped without penalty (docs/architecture.md, play-first delivery)" },
    "interstitialEveryRounds": { "$type": "number", "$value": 3, "$description": "Mandatory interstitial after every 3rd round; served from /v1/config" }
  }
}
