# Copy to .env.local. Points the SPA at the Worker. Defaults to the local `wrangler dev` port.
VITE_API_BASE=http://localhost:8787
# How the admin signs in: leave unset for Cloudflare Access, or "firebase" to sign in with Google (docs/ops.md).
# VITE_ADMIN_LOGIN=firebase
# With firebase: the Firebase web app's config (Project settings > Your apps > Web app).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=yeman-zefen-prod.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=yeman-zefen-prod
# VITE_FIREBASE_APP_ID=
